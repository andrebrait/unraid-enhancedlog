<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="enhanced.log"
  author="Derek Kaser"
  version="2026.11.13.0000"
  launch="Tools/EnhancedSyslog"
  pluginURL="https://raw.githubusercontent.com/andrebrait/unraid-enhancedlog/main/plugin/enhanced.log.plg"
  support="https://forums.unraid.net/topic/191178-plugin-enhanced-log-advanced-syslog-viewer-for-unraid/"
  min="7.0.0"
  
  icon="align-left"
>

<CHANGES>
<![CDATA[

### 2026.11.13.0000

- Build: releases are now produced with the andrebrait forks of the Unraid plugin release action and release drafter. No functional changes.

### 2026.11.12.0000

- Security: log text, sources and services are now escaped before display, so crafted syslog lines can no longer inject HTML or scripts into the Enhanced Log page.

### 2026.11.11.0000

- Fork: plugin, package and updates now come from https://github.com/andrebrait/unraid-enhancedlog


For older releases, see https://github.com/andrebrait/unraid-enhancedlog/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/enhanced.log/unraid-enhancedlog-2026.11.13.0000-noarch-1.txz">
<URL>https://github.com/andrebrait/unraid-enhancedlog/releases/download/2026.11.13.0000/unraid-enhancedlog-2026.11.13.0000-noarch-1.txz</URL>
<SHA256>bac49e010625fa7bd53c59b35d07e7e7ee95b99f18feb71e2614e0c2b477aab3</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/enhanced.log/unraid-enhancedlog-2026.11.13.0000-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/enhanced.log/unraid-enhancedlog-*.txz 2>/dev/null | grep -v '2026.11.13.0000')

echo "VERSION=2026.11.13.0000" > /usr/local/emhttp/plugins/enhanced.log/version.ini

echo ""
echo "----------------------------------------------------"
echo " enhanced.log has been installed."
echo " Version: 2026.11.13.0000"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-enhancedlog

rm -rf /usr/local/emhttp/plugins/enhanced.log
rm -rf /boot/config/plugins/enhanced.log

# Remove rsyslog filtering.
rm -rf /etc/rsyslog.d/02-blocklist-extra.conf

# Restart rsyslog
echo "Restarting rsyslog..."
/etc/rc.d/rc.rsyslogd restart >/dev/null
]]>
</INLINE>
</FILE>

</PLUGIN>
